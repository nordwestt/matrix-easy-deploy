{
    "default_server_config": {
        "m.homeserver": {
            "base_url": "https://{{GUEST_SERVER_NAME}}",
            "server_name": "{{GUEST_SERVER_NAME}}"
        },
        "org.matrix.msc4143.rtc_foci": [
            {
                "type": "livekit",
                "livekit_service_url": "https://{{LIVEKIT_DOMAIN}}/livekit/jwt"
            }
        ]
    },
    "livekit": {
        "livekit_service_url": "https://{{LIVEKIT_DOMAIN}}/livekit/jwt"
    },
    "features": {
        "feature_use_device_session_member_events": true
    },
    "ssla": "",
    "matrix_rtc_mode": "compatibility",
