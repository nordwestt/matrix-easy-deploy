# Guest Tuwunel homeserver for Element Call external access
# Generated by matrix-easy-deploy — re-run apply.sh to regenerate.

[global]
server_name = "{{GUEST_SERVER_NAME}}"
database_path = "/data"
address = ["0.0.0.0"]
port = 8008

# Open registration required for standalone Element Call (guest accounts only).
allow_registration = true
yes_i_am_very_very_sure_i_want_an_open_registration_server_prone_to_abuse = true

# Guests join meetings on the main server — they must not create rooms/calls here.
allow_room_creation = false

allow_federation = true
allow_public_room_directory_over_federation = false

# Federate only with the principal homeserver and this guest server (Tuwunel requires
# its own server_name in the allow-list or outbound federation PDUs are dropped).
# Single-quoted: regex backslashes are literal in TOML (double quotes treat \. as invalid escapes).
allowed_remote_server_names_experimental = ['^{{GUEST_FEDERATION_ALLOW_REGEX}}$']

[global.well_known]
client = "https://{{GUEST_SERVER_NAME}}"
# Tell federating homeservers (Synapse) to reach us on 443 via Caddy, not 8448.
server = "{{GUEST_SERVER_NAME}}:443"
# MatrixRTC — use the main server's LiveKit SFU (must be under [global.well_known]).
livekit_url = "https://{{LIVEKIT_DOMAIN}}/livekit/jwt"
