# Generated by apply.sh — main homeserver extra_hosts for guest federation key fetches.
# Without this, Synapse/Tuwunel in Docker often cannot hairpin to the guest server's public URL.
services:
  synapse:
    extra_hosts:
      "{{GUEST_SERVER_NAME}}": "host-gateway"
  tuwunel:
    extra_hosts:
      "{{GUEST_SERVER_NAME}}": "host-gateway"
