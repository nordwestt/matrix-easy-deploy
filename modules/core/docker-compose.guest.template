# Generated by apply.sh — main homeserver extra_hosts for guest federation key fetches.
# Docker's embedded DNS (127.0.0.11) often cannot resolve public hostnames from inside
# containers even when the host can. extra_hosts bypasses DNS via /etc/hosts.
services:
  synapse:
    extra_hosts:
      "{{GUEST_SERVER_NAME}}": "host-gateway"
    dns:
      - 1.1.1.1
      - 8.8.8.8
  tuwunel:
    extra_hosts:
      "{{GUEST_SERVER_NAME}}": "host-gateway"
    dns:
      - 1.1.1.1
      - 8.8.8.8
